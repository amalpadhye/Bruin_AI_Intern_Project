{
  "expo": {
    "name": "ForkU",
    "slug": "forku-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forku.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ForkU needs access to your camera to scan food photos.",
        "NSPhotoLibraryUsageDescription": "ForkU needs access to your photo library to select food photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.forku.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ForkU to access your camera to scan food photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ForkU to access your photos to select food images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "forku",
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}

